# Copie para .env e preencha. NUNCA comite o .env.

# --- Supabase / Postgres ---
# Connection string do Postgres (Supabase > Project Settings > Database).
# Use a porta 6543 (pooler) para o app; 5432 (direct) para migrações.
DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (provedor atual do projeto) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Embeddings ---
# Padrão: text-embedding-3-small (1536 dims). Mudar o modelo depois exige
# alterar a dimensão da coluna `chunks.embedding` e reindexar.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Rerank (opcional; só entra se o eval mostrar que vale) ---
RERANK_API_KEY=
RERANK_MODEL=

# --- PubMed E-utilities (opcional; melhora o rate limit) ---
NCBI_API_KEY=
NCBI_EMAIL=

# --- Sessão / login (Fase B, multiusuário) ---
# Assina os cookies de sessão (HMAC). Use um valor aleatório longo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# No Render, defina este valor no painel (ou use o botão Generate).
SESSION_SECRET=

# --- Integrações de calendário (OAuth) ---
# Base pública das URLs de callback (localhost para dev).
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra (Azure AD) → App registrations → novo app (Web).
# Redirect URI: http://127.0.0.1:8000/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
